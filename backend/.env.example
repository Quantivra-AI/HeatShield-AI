# Copy this file to .env for local configuration.
# Never commit .env or put real secrets in this example file.

# Required before deployment: generate a long, random secret.
HEATSHIELD_AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
HEATSHIELD_TOKEN_TTL_SECONDS=28800

# Local-only first-run administrator bootstrap.
HEATSHIELD_BOOTSTRAP_ADMIN_EMAIL=admin@heatshield.ai
HEATSHIELD_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Comma-separated exact frontend origins; do not use * with credentials.
HEATSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables AI-generated BioTwin synthesis.
# Evidence retrieval can still provide source-grounded results without this key.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
